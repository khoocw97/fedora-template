#!/bin/bash
set -euo pipefail

# Fcitx5 Rime user directory
RIME_DIR="$HOME/.local/share/fcitx5/rime"

# Check for and install Fcitx5/Rime dependencies (Fedora)
install_deps() {
    echo "==== Checking and installing Fcitx5/Rime dependencies (Fedora) ===="
    if ! command -v dnf &>/dev/null; then
        echo "Error: dnf not found; Fedora only"
        exit 1
    fi
    echo "Installing dependencies..."
    sudo dnf install -y \
        fcitx5 \
        fcitx5-chinese-addons \
        fcitx5-rime \
        fcitx5-gtk \
        fcitx5-qt \
        fcitx5-configtool \
        librime-lua \
        librime-octagram
}

# Fetch the Plum installer
clone_plum() {
    TMP_DIR=$(mktemp -d)
    if ! git clone https://github.com/rime/plum.git "$TMP_DIR/plum"; then
        rm -rf "$TMP_DIR"
        echo "Failed to fetch Plum; check the network and retry. Existing configuration was not changed."
        return 1
    fi
}

# Download and install Rime-ice (full pinyin)
apply_rime() {
    clone_plum || return 1
    cd "$TMP_DIR/plum"

    echo -e "\n==== 1. Installing/updating Rime-ice (full pinyin) ===="
    rime_dir="$RIME_DIR" bash rime-install iDvel/rime-ice

    echo -e "\n==== 2. Installing the grammar model (full pinyin) ===="
    rime_dir="$RIME_DIR" bash rime-install iDvel/rime-ice:others/recipes/grammar:schema=rime_ice

    rm -rf "$TMP_DIR"

    echo -e "\n==== Done ===="
    echo "Reboot to apply the new input method configuration."
}

# Install (including dependencies)
install_rime() {
    install_deps
    apply_rime
}

if [[ "${1:-install}" != "install" ]]; then
    echo "Usage: $(basename "$0") [install]" >&2
    exit 1
fi
install_rime
