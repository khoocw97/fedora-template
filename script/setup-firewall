#!/usr/bin/env bash
set -euo pipefail

for zone in home public; do
  # mDNS (5353/udp, host discovery)
  sudo firewall-offline-cmd --zone="$zone" --add-service=mdns
  # KDE Connect (1714-1764/tcp+udp)
  sudo firewall-offline-cmd --zone="$zone" --add-service=kdeconnect
  # LocalSend (53317/tcp+udp)
  sudo firewall-offline-cmd --zone="$zone" --add-port=53317/tcp
  sudo firewall-offline-cmd --zone="$zone" --add-port=53317/udp
  # Sunshine (47984/47989/47990/48010 tcp, 47998-48000/48002/48010 udp)
  sudo firewall-offline-cmd --zone="$zone" --add-port=47984/tcp --add-port=47989/tcp \
    --add-port=47990/tcp --add-port=48010/tcp
  sudo firewall-offline-cmd --zone="$zone" --add-port=47998-48000/udp \
    --add-port=48002/udp --add-port=48010/udp
done

# apply permanent rules to the running firewalld
sudo firewall-cmd --reload
